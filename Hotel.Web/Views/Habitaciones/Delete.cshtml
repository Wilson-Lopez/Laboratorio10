@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Eliminar habitación";
    var bloqueado = ViewBag.TieneReservasVigentes as bool? ?? false;
}

<h1 class="h3">Eliminar habitación</h1>
@if (bloqueado)
{
    <div class="alert alert-warning">
        No se puede eliminar: la habitación tiene reservas <strong>pendientes o confirmadas</strong>.
        Revíselas en <a asp-action="Details" asp-route-id="@Model.IdHabitacion">su detalle</a> y cancélelas primero.
    </div>
}
else
{
    <p class="text-danger">¿Seguro que desea eliminar esta habitación? Dejará de aparecer en los listados y en la disponibilidad.</p>
}
<hr />
<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>
    <dt class="col-sm-3">Piso</dt>
    <dd class="col-sm-9">@Model.Piso</dd>
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.IdTipoNavigation.Nombre</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdHabitacion" />
    <button type="submit" class="btn btn-danger" disabled="@bloqueado">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
