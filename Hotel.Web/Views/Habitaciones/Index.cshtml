@using System.Globalization
@model IEnumerable<Hotel.Web.Models.Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
    ViewData["AnchoCompleto"] = true;

    var ocupadas = ViewBag.Ocupadas as HashSet<int> ?? new HashSet<int>();
    var hayFiltros = ViewBag.HayFiltros as bool? ?? false;
    decimal precioTope = ViewBag.PrecioTope;
    decimal? precioMax = ViewBag.PrecioMax;

    // Rango del deslizador en múltiplos de 10 para que el tope sea alcanzable
    var rangoMin = Math.Floor((decimal)ViewBag.PrecioMin / 10) * 10;
    var rangoMax = Math.Ceiling(precioTope / 10) * 10;
    string Num(decimal v) => v.ToString("F0", CultureInfo.InvariantCulture);
}

<section class="page-banner">
    <div class="container">
        <h1>Nuestras habitaciones</h1>
        <p>Encuentra el espacio ideal para disfrutar de una estancia cómoda y memorable.</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <form asp-action="Index" method="get" class="filtros">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label for="idTipo" class="form-label">Tipo de habitación</label>
                    <select id="idTipo" name="idTipo" class="form-select rounded-pill" asp-items="ViewBag.IdTipo">
                        <option value="">Todos los tipos</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="capacidad" class="form-label">Capacidad</label>
                    <select id="capacidad" name="capacidad" class="form-select rounded-pill" asp-items="ViewBag.Capacidad">
                        <option value="">Cualquier capacidad</option>
                    </select>
                </div>
                <div class="col-sm-8 col-lg-3">
                    <label for="precioMax" class="form-label d-flex justify-content-between">
                        <span>Precio</span>
                        <output id="precioTexto" class="precio-texto"></output>
                    </label>
                    <input type="range" id="precioMax" name="precioMax" class="form-range"
                           min="@Num(rangoMin)" max="@Num(rangoMax)" step="10" value="@Num(precioMax ?? rangoMax)" />
                </div>
                <div class="col-sm-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill flex-grow-1">Filtrar</button>
                    @if (hayFiltros)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Limpiar</a>
                    }
                </div>
            </div>
        </form>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-4">
            <p class="text-muted mb-0">
                <strong class="text-body">@Model.Count()</strong> @(Model.Count() == 1 ? "habitación encontrada" : "habitaciones encontradas")
            </p>
            <a asp-action="Create" class="btn btn-outline-primary rounded-pill">+ Nueva habitación</a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                var tipo = item.IdTipoNavigation;
                var p = PresentacionTipo.Para(tipo.Nombre);
                var ocupada = ocupadas.Contains(item.IdHabitacion);
                <div class="col">
                    <article class="card room-card">
                        <div class="room-img">
                            <img src="~/img/@p.Imagen" alt="Habitación @item.Numero (@tipo.Nombre)" loading="lazy" />
                            <span class="room-tipo">@tipo.Nombre</span>
                            <div class="dropdown room-admin">
                                <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-label="Opciones de la habitación @item.Numero">
                                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="12" cy="19" r="1" /></svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.IdHabitacion">Editar</a></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.IdHabitacion">Eliminar</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <h2 class="h4 mb-1">Habitación @item.Numero</h2>
                            <p class="small text-muted mb-2">Piso @item.Piso · @tipo.Nombre</p>
                            <p class="small mb-3">@p.Descripcion</p>
                            <div class="room-amenidades mb-3">
                                <span>
                                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                    @tipo.Capacidad @(tipo.Capacidad == 1 ? "huésped" : "huéspedes")
                                </span>
                                <span>
                                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20" /><path d="M6 8v4h6V8" /></svg>
                                    @p.Cama
                                </span>
                                <span>
                                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0" /><line x1="12" y1="20" x2="12.01" y2="20" /></svg>
                                    WiFi gratuito
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                                <div class="room-precio fs-4">S/ @tipo.PrecioNoche.ToString("N0")<small class="fs-6"> / noche</small></div>
                                @if (ocupada)
                                {
                                    <span class="estado-chip estado-ocupada">Ocupada hoy</span>
                                }
                                else
                                {
                                    <span class="estado-chip estado-libre">Disponible hoy</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.IdHabitacion" class="btn btn-outline-primary rounded-pill flex-fill">Ver detalles</a>
                                <a asp-controller="Reservas" asp-action="Create" asp-route-idHabitacion="@item.IdHabitacion" class="btn btn-gold rounded-pill flex-fill">Reservar</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">No hay habitaciones que coincidan con los filtros elegidos.</p>
                <a asp-action="Index" class="btn btn-outline-primary rounded-pill">Ver todas las habitaciones</a>
            </div>
        }
    </div>
</section>

<section class="cta-band">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <h2 class="mb-0">Encuentra la habitación perfecta para ti</h2>
        <a asp-controller="Reservas" asp-action="Disponibles" class="btn btn-outline-light btn-lg rounded-pill px-4">Consultar disponibilidad</a>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const rango = document.getElementById('precioMax');
            const texto = document.getElementById('precioTexto');
            const formato = new Intl.NumberFormat('es-PE', { maximumFractionDigits: 0 });
            function actualizar() {
                texto.textContent = Number(rango.value) >= Number(rango.max)
                    ? 'Cualquier precio'
                    : `Hasta S/ ${formato.format(rango.value)}`;
            }
            rango.addEventListener('input', actualizar);
            actualizar();
        })();
    </script>
}
