@model List<Hotel.Web.Models.Habitacion>
@{
    // Tarjetas de habitaciones disponibles / no disponibles + panel "Reserva segura"
    var ingreso = (DateOnly)ViewBag.BuscadorIngreso;
    var salida = (DateOnly)ViewBag.BuscadorSalida;
    var noches = ViewBag.Noches as int? ?? 0;
    var noDisponibles = ViewBag.NoDisponibles as List<Hotel.Web.Models.Habitacion> ?? new();

    // Disponibles primero y luego las ocupadas en el rango
    var tarjetas = Model.Select(h => (Habitacion: h, Libre: true))
                        .Concat(noDisponibles.Select(h => (Habitacion: h, Libre: false)))
                        .ToList();
}

@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
                <h2 class="titulo-sans mb-0">Habitaciones disponibles</h2>
                <span class="text-muted small">
                    @ingreso.ToString("dd MMM") – @salida.ToString("dd MMM yyyy") ·
                    <strong class="text-body">@noches @(noches == 1 ? "noche" : "noches")</strong> ·
                    @Model.Count @(Model.Count == 1 ? "libre" : "libres")
                </span>
            </div>

            @if (!tarjetas.Any())
            {
                <div class="text-center border rounded-4 py-5">
                    <p class="text-muted mb-0">No hay habitaciones que coincidan con la búsqueda. Prueba con otras fechas o filtros.</p>
                </div>
            }

            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
                @foreach (var (h, libre) in tarjetas)
                {
                    var tipo = h.IdTipoNavigation;
                    var p = PresentacionTipo.Para(tipo.Nombre);
                    <div class="col">
                        <article class="card room-card room-card-compacta @(libre ? "" : "no-disponible")">
                            <div class="room-img">
                                <img src="~/img/@p.Imagen" alt="Habitación @h.Numero (@tipo.Nombre)" loading="lazy" />
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h3 class="titulo-tarjeta">Habitación @h.Numero · @tipo.Nombre</h3>
                                <p class="descripcion">@p.Descripcion</p>
                                <div class="room-amenidades mb-2">
                                    <span>
                                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0" /><line x1="12" y1="20" x2="12.01" y2="20" /></svg>
                                        Wi-Fi
                                    </span>
                                    <span>
                                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                                        @tipo.Capacidad pers.
                                    </span>
                                    <span>
                                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20" /><path d="M6 8v4h6V8" /></svg>
                                        @p.Cama
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-auto mb-1">
                                    <div class="precio-tarjeta">S/ @tipo.PrecioNoche.ToString("N0") <small>/ noche</small></div>
                                    <span class="estado-chip @(libre ? "estado-libre" : "estado-no")">@(libre ? "Disponible" : "No disponible")</span>
                                </div>
                                <p class="small text-muted mb-2">Total @noches @(noches == 1 ? "noche" : "noches"): S/ @((noches * tipo.PrecioNoche).ToString("N2"))</p>
                                @if (libre)
                                {
                                    <a asp-controller="Reservas" asp-action="Create" asp-route-idHabitacion="@h.IdHabitacion"
                                       asp-route-ingreso="@ingreso.ToString("yyyy-MM-dd")" asp-route-salida="@salida.ToString("yyyy-MM-dd")"
                                       class="btn btn-gold-degradado rounded-pill w-100">Seleccionar habitación</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-no-disponible rounded-pill w-100" disabled>No disponible</button>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-3">
            <div class="reserva-segura">
                <h2 class="h3 text-center mb-4">Reserva segura</h2>
                <div class="item">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    <h3>Confirmación inmediata</h3>
                </div>
                <div class="item">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    <h3>Datos protegidos</h3>
                </div>
                <div class="item">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
                    <h3>Atención al cliente</h3>
                </div>
            </div>
        </aside>
    </div>
}
