@model IEnumerable<Hotel.Web.Models.Reserva>
@{
    ViewData["Title"] = "Reservas registradas";
    ViewData["AnchoCompleto"] = true;
}

<section class="pagina-gris" id="registradas">
<div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="mb-0">Reservas registradas</h1>
        <a asp-action="Create" class="btn btn-outline-primary rounded-pill">+ Nueva reserva</a>
    </div>

    <form asp-action="Listado" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-sm-4 col-lg-3">
            <label for="estado" class="form-label small text-muted">Estado</label>
            <select id="estado" name="estado" class="form-select" asp-items="ViewBag.Estado">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-sm-5 col-lg-4">
            <label for="buscar" class="form-label small text-muted">Huésped, documento o N° habitación</label>
            <input id="buscar" name="buscar" class="form-control" value="@ViewBag.Buscar" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Listado" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="aviso-barra mb-3">
        Flujo: <partial name="_EstadoBadge" model="EstadoReserva.Pendiente" /> → <partial name="_EstadoBadge" model="EstadoReserva.Confirmada" />
        → <partial name="_EstadoBadge" model="EstadoReserva.Finalizada" /> (desde el día de ingreso).
        Las pendientes o confirmadas se pueden <partial name="_EstadoBadge" model="EstadoReserva.Cancelada" />.
    </div>

    <div class="tabla-card tabla-oro">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Huésped</th>
                        <th>Habitación</th>
                        <th>Ingreso</th>
                        <th>Salida</th>
                        <th class="text-end">Noches</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.IdReserva</td>
                            <td class="text-nowrap">
                                @item.IdHuespedNavigation.NombreCompleto
                                <div class="small text-muted">@item.IdHuespedNavigation.Documento</div>
                            </td>
                            <td class="text-nowrap">
                                @item.IdHabitacionNavigation.Numero
                                <div class="small text-muted">@item.IdHabitacionNavigation.IdTipoNavigation.Nombre</div>
                            </td>
                            <td class="text-nowrap">@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td class="text-nowrap">@item.FechaSalida.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@item.Noches</td>
                            <td><partial name="_EstadoBadge" model="item.Estado" /></td>
                            <td class="text-end text-nowrap">S/ @((item.Noches * item.IdHabitacionNavigation.IdTipoNavigation.PrecioNoche).ToString("N2"))</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-secondary">Detalle</a>
                                <partial name="_AccionesReserva" model="item" />
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No hay reservas para mostrar.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</section>
